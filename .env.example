# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git не кладите — там пароли.

# --- Сайт: режим работы ---

# development = компьютер для разработки. production = сервер в интернете.
ENVIRONMENT=development

# Секрет подписи входа (JWT). Это не пароль базы и не пароль почты.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
# На сервере — свой ключ, не оставляйте пример из разработки.
SECRET_KEY=

# Публичный адрес API, без слэша в конце. Сайт и письма ходят сюда.
# Локально без Docker: http://localhost:8000
# Docker + nginx: http://localhost/api   (не :8000 — иначе пустые страны/города)
# Сервер: https://ваш-домен/api
PUBLIC_API_URL=http://localhost/api

# Адрес сайта для ссылок в письмах (подтверждение почты, сброс пароля).
# Локально npm start: http://localhost:3000
# Docker: http://localhost
# Сервер: https://ваш-домен
PUBLIC_APP_URL=http://localhost:3000

# Вход через Google. Пусто = кнопки Google не будет.
# Берётся в кабинете Google Cloud → OAuth client ID.
GOOGLE_CLIENT_ID=

# Какие адреса сайта имеют право вызывать API (через запятую, без пробелов вокруг).
# Локально: localhost:3000. Docker на :80: http://localhost,http://127.0.0.1
# Сервер: https://ваш-домен
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# --- База данных ---

# Полный адрес PostgreSQL для backend.
# Локально: postgresql+asyncpg://ЛОГИН:ПАРОЛЬ@localhost:5432/ИМЯ_БАЗЫ
# Docker:   postgresql+asyncpg://ЛОГИН:ПАРОЛЬ@db:5432/ИМЯ_БАЗЫ
# Пароль здесь и в POSTGRES_PASSWORD должны совпадать.
DATABASE_URL=

# Логин, пароль и имя базы для контейнера PostgreSQL (только Docker Compose).
# Пароль придумайте свой, не копируйте логин.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# true = при старте самому создавать таблицы (удобно дома).
# На сервере всегда false: схема только миграциями Alembic.
AUTO_CREATE_DB=true

# Заполнить справочник категорий/работ из словаря. Дома обычно true, на сервере можно false.
SEED_DEFAULT_WORKS=true

# В Docker при старте backend накатить миграции. Обычно оставьте true.
RUN_MIGRATIONS_ON_STARTUP=true

# Печатать каждый SQL-запрос в лог. На сервере должно быть false.
SQL_ECHO=false

# Бэкапы базы (сервис db-backup в Docker): сколько дней хранить и как часто делать.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Логи и ошибки ---

# Подробность логов: DEBUG дома, на сервере INFO или WARNING.
LOG_LEVEL=DEBUG

# Писать заголовки запросов в лог. На сервере оставьте false.
LOG_VERBOSE_REQUESTS=false

# Необязательно: мониторинг ошибок Sentry. Пусто = выключено.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Вход (JWT) ---

# Сколько минут действует сессия, пока человек на сайте.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Сколько дней можно оставаться «вошедшим» без нового пароля (refresh).
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Оплата (для пилота без WebPay можно не трогать, кроме секрета) ---

# Секрет, по которому платёжка стучится на /payment/callback. Свой случайный, не как SECRET_KEY.
PAYMENT_CALLBACK_SECRET=

# Если шлюз шлёт callback не на стандартный адрес — укажите его здесь.
# PAYMENT_CALLBACK_URL=

# true = можно тестовую оплату без карты. На сервере false.
PAYMENT_ALLOW_TEST=true

# Адрес шлюза WebPay. Пока оплаты нет — можно оставить локальный mock.
WEBPAY_API_URL=http://localhost:8001/payment

# --- Защита от перебора пароля ---

# Сколько попыток входа/регистрации с одного IP за окно времени.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Почта ---

# true = после регистрации нельзя войти, пока не открыли ссылку из письма.
# Дома false удобнее. На сервере должно быть true (или поставьте ENVIRONMENT=production).
REQUIRE_EMAIL_VERIFICATION=false

# Почтовый сервер. Пустой SMTP_HOST = письма только в лог, на почту не уйдут.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=ваша@gmail.com
# SMTP_PASSWORD=пароль_приложения_без_пробелов
# SMTP_FROM_EMAIL=ваша@gmail.com
# SMTP_FROM_NAME=Fixer
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# --- Админка ---

# true = любой вошедший как админ (только для пустой тестовой базы).
# На сервере false, а себе роль admin выдайте в PostgreSQL.
OPEN_ADMIN_ACCESS=true

# --- Жив ли сервер ---

# Если /health плохой — дернуть webhook (Slack/Discord). Пусто = не слать.
UPTIME_ALERT_WEBHOOK_URL=
HEALTH_ALERT_COOLDOWN_SECONDS=300

# --- Docker: сколько процессов API ---

# 2 — спокойно для слабой машины. Больше — только если есть свободная память.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Файлы (аватарки, портфолио, загрузки) ---

# Папки на диске. В Docker compose сам подставит /app/...
UPLOADS_FOLDER=uploads
AVATARS_DIR=avatars
PORTFOLIO_DIR=portfolio

# local = файлы на этом сервере. s3 = общее хранилище (MinIO/AWS), если несколько копий backend.
FILE_STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=fixer-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
